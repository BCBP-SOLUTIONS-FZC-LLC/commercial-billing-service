# Terraform snippet: attach the reference policy in deploy/iam/policy.json to
# an IRSA role. Illustrative only, not applied by the application; platform
# Terraform owns the authoritative version of these resources.

# 1. Trust policy: the ServiceAccount commercial-billing in namespace billing
#    (BIL-OPS-4) assumes this role through IRSA. The migrate Job and every
#    CronJob in deploy/helm/templates/ run as the same ServiceAccount.
data "aws_iam_policy_document" "commercial_billing_trust" {
  statement {
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = [aws_iam_openid_connect_provider.eks.arn]
    }
    condition {
      test     = "StringEquals"
      variable = "${replace(aws_iam_openid_connect_provider.eks.url, "https://", "")}:sub"
      values   = ["system:serviceaccount:billing:commercial-billing"]
    }
    condition {
      test     = "StringEquals"
      variable = "${replace(aws_iam_openid_connect_provider.eks.url, "https://", "")}:aud"
      values   = ["sts.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "commercial_billing" {
  name               = "commercial-billing"
  assume_role_policy = data.aws_iam_policy_document.commercial_billing_trust.json
}

# The queues are subscribed to other services' topics (tenant-billing-q to
# IAM's tenant events, usage-billing-q to Usage & Metering's); platform
# Terraform provisions them with a RedrivePolicy, which the server requires
# outside dev (requireDLQ, cmd/server/events.go).
data "aws_sqs_queue" "tenant_billing" { name = "tenant-billing-q" }
data "aws_sqs_queue" "tenant_billing_dlq" { name = "tenant-billing-q-dlq" }
data "aws_sqs_queue" "usage_billing" { name = "usage-billing-q" }
data "aws_sqs_queue" "usage_billing_dlq" { name = "usage-billing-q-dlq" }

# 2. Permission policy, templated from deploy/iam/policy.json: one SNS topic,
#    two queues and their DLQs, one Glue registry (LLD §7.2, §7.6).
resource "aws_iam_policy" "commercial_billing" {
  name = "commercial-billing"
  policy = templatefile("${path.module}/policy.json", {
    billing_events_topic_arn = aws_sns_topic.billing_events.arn

    tenant_billing_queue_arn     = data.aws_sqs_queue.tenant_billing.arn
    tenant_billing_queue_dlq_arn = data.aws_sqs_queue.tenant_billing_dlq.arn
    usage_billing_queue_arn      = data.aws_sqs_queue.usage_billing.arn
    usage_billing_queue_dlq_arn  = data.aws_sqs_queue.usage_billing_dlq.arn

    billing_registry_arn = aws_glue_registry.billing_events.arn
    # schema/* is a distinct Glue resource type from registry/*: schemas live
    # under schema/<registry-name>/<schema-name>. The /* is added in policy.json.
    billing_schema_arn_prefix = "arn:aws:glue:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:schema/${aws_glue_registry.billing_events.registry_name}"
  })
}

resource "aws_iam_role_policy_attachment" "commercial_billing" {
  role       = aws_iam_role.commercial_billing.name
  policy_arn = aws_iam_policy.commercial_billing.arn
}

# ─────────────────────────────────────────────────────────────────────────
# Schema-registration CI role: NOT the pod role above. The pod only reads
# Glue; .github/workflows/schema-registry.yml registers schemas with the
# per-environment AWS credentials of a separate CI principal, which needs:
#   glue:CreateSchema, glue:RegisterSchemaVersion, glue:UpdateSchema,
#   glue:PutSchemaVersionMetadata, glue:GetSchema, glue:GetSchemaVersion,
#   glue:GetSchemaByDefinition, glue:ListSchemaVersions
#   cloudwatch:PutMetricData (namespace BCBP/SchemaRegistry, schema-gov metrics)
# Do not add these to the pod policy.
# ─────────────────────────────────────────────────────────────────────────
