{
  "title": "Commercial / Billing",
  "uid": "commercial-billing",
  "tags": [
    "commercial",
    "billing"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "description": "LLD \u00a711.5 dashboard. Tier 1 platform_* and Tier 3 commercial_billing_* series only (Enterprise Platform Observability Standard, rev 0.43).",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Conversion funnel",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sagas in flight by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (saga_state) (commercial_billing_sagas_in_flight{service=\"commercial-billing\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Saga duration p95 by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
