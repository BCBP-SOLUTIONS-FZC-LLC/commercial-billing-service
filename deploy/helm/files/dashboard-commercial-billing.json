      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(commercial_billing_conversion_saga_duration_seconds_bucket{service=\"commercial-billing\"}[15m])))",
          "legendFormat": "__auto"
