# Copy to .env for `make run` (never commit .env). Values match docker-compose.yml.
APP_ENV=dev
APP_PORT=8180
METRICS_PORT=9190

# App pool (billing_app, RLS), read by platform-pgcommon. Direct to Postgres:
# the compose PgBouncer (5633) admits billing_app only. PG_BOUNCER_MODE keeps
# the simple protocol of deployed environments.
PG_HOST=localhost
PG_PORT=5634
PG_DBNAME=billing
PG_USER=billing_app
PG_PASSWORD=devpassword
PG_SSLMODE=disable
PG_BOUNCER_MODE=true
PG_STATEMENT_TIMEOUT=5s
PG_LOCK_TIMEOUT=2s

# sysPool (billing_system, BYPASSRLS) and the platform-audit drainer: the
# same pgcommon settings as the app pool with their own role (LLD §3.3).
PG_SYSTEM_USER=billing_system
PG_SYSTEM_PASSWORD=devpassword
PG_AUDIT_DRAINER_USER=billing_audit_drainer
PG_AUDIT_DRAINER_PASSWORD=devpassword
# Migrations, direct to Postgres (session advisory lock, never PgBouncer)
MIGRATION_DATABASE_URL=postgres://billing_migrator:devpassword@localhost:5634/billing?sslmode=disable
RUN_MIGRATIONS=true

# Events (floci: SNS / SQS / Glue)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4667
SNS_BILLING_EVENTS_TOPIC_ARN=arn:aws:sns:ap-south-1:000000000000:billing-events
SQS_TENANT_BILLING_QUEUE_URL=http://localhost:4667/000000000000/tenant-billing-q
SQS_USAGE_BILLING_QUEUE_URL=http://localhost:4667/000000000000/usage-billing-q

# Stripe (stripe-mock); test keys only outside prod (BIL-OPS-7)
STRIPE_API_KEY=rk_test_local
STRIPE_WEBHOOK_SECRETS=whsec_local

TENANT_APP_BASE_URL=http://localhost:3000
CORE_BASE_URL=http://localhost:8080
RP_BASE_URL=http://localhost:8081
ENTITLEMENTS_BASE_URL=http://localhost:8280

# Feature flags (§12)
FEATURE_DIRECT_SIGNUP=false
FEATURE_TOKEN_ADDONS=false
FEATURE_SEAT_PURCHASE=true

# Operator routes outside dev/test open only once IAM's operator path is live (BIL-AUTH-6).
OPERATOR_PATH_LIVE=false
