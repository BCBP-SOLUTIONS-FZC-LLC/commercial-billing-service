{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TenantQuotaAddOnChangedPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "resource",
    "delta",
    "reason",
    "billing_ref"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource": {
      "type": "string",
      "enum": [
        "llm_tokens",
        "api_requests"
      ]
    },
    "delta": {
      "type": "integer",
      "not": {
        "const": 0
      }
    },
    "reason": {
      "type": "string",
      "enum": [
        "purchase",
        "refund"
      ]
    },
    "billing_ref": {
      "type": "string"
    },
    "purchase_ref": {
      "type": "string"
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time"
    },
    "pack_code": {
      "type": "string"
    },
    "pack_quantity": {
      "type": "integer",
      "minimum": 1
    }
  }
}
